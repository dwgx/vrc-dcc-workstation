{
  "mcpServers": {
    "blender": {
      "command": "{{UVX}}",
      "args": ["--python", "3.11", "blender-mcp==1.9.0"],
      "env": {
        "UV_PYTHON_PREFERENCE": "only-managed",
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876"
      }
    },
    "unityMCP": {
      "url": "http://localhost:8080/mcp"
    }
  }
}
